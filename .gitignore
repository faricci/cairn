# --- Python build artifacts ---
# Compiled bytecode is machine- and version-specific; six .pyc files are
# currently committed under cairnlib/ and should be removed from git.
__pycache__/
*.py[cod]
.ruff_cache/

# Cairn harness — generated by `cairn apply` (dogfooding artifacts).
# The source of truth is harness/, cairnlib/, and cairn.py. Everything below is
# regenerable and must not be committed.
.cairn/
# Root-anchored: this ignores the dogfooding artifact at the repo root only.
# Without the leading slash it would also match harness/guides/AGENTS.md, which
# is a manifest source - and a clone missing it cannot run `cairn apply` at all.
/AGENTS.md

# --- Examples ---
# validate-repo is a throwaway target rebuilt by the validate scripts, and the
# scripts themselves use machine-specific absolute paths: local dev only.
examples/validate-repo/
examples/validate.ps1
examples/validate2.ps1

# The sample-repo IS a shipped, practical example. The rules above ignore
# `.cairn/` and `AGENTS.md` everywhere, so re-include only what a reader needs:
# the per-repo config and the agent guide. The vendored engine/sensors are
# recreated by `cairn apply` and stay out of git.
!examples/sample-repo/.cairn/
examples/sample-repo/.cairn/*
!examples/sample-repo/.cairn/cairn.toml
!examples/sample-repo/AGENTS.md